# =========================================================================
# CENTRALIZED SECURE GITIGNORE FOR ALL PROJECTS
# =========================================================================

# -------------------------------------------------------------------------
# 🔑 Environment & Confidential Files (CRITICAL SECRETS - NEVER COMMIT!)
# -------------------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
**/.env
**/*.env
.env.*

# Keystores, certificates, and private credentials
*.pem
*.key
*.cert
*.jks
*.p12
*.pub
credentials*.json
secrets*.properties

# -------------------------------------------------------------------------
# 📦 Dependency & Build Folders
# -------------------------------------------------------------------------
# Java Backend (Maven)
**/target/
**/*.class
**/*.jar
**/*.war
**/*.ear
**/*.zip
**/*.tar.gz

# Node.js Frontend (Vite / React)
**/node_modules/
**/dist/
**/dist-ssr/
**/.svelte-kit/
**/.next/
**/.nuxt/

# -------------------------------------------------------------------------
# 🛠️ IDEs, Editors & System Files
# -------------------------------------------------------------------------
.idea/
.vscode/
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
*.bak
*.tmp
*.temp

# -------------------------------------------------------------------------
# 📋 Logs and Debug Info
# -------------------------------------------------------------------------
**/logs/
**/*.log
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*
**/lerna-debug.log*
